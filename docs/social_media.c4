specification {
  element person {
      style {
          shape person
          color green
      }
  }
  element softwareSystem
  element container
  element component
}

model {
  user = person "Пользователь" "Пользователь социальной сети"

  social_network = softwareSystem "Социальная сеть" {
    api_gateway = container "API Gateway" {
      description "Маршрутизация запросов и управление доступом"
      technology "Python, FastAPI"
    }

    user_service = container "User Service" {
      description "Управление пользователями и аутентификация"
      technology "Python, FastAPI, gRPC, PostgreSQL"
    }

    post_service = container "Post Service" {
      description "Управление постами, комментариями и лайками"
      technology "Python, gRPC, PostgreSQL"
    }

    statistics_service = container "Statistics Service" {
      description "Сбор и анализ статистики, аналитика"
      technology "Python, gRPC, ClickHouse"
    }

    message_broker = container "Kafka" {
      description "Брокер сообщений для событий между сервисами"
      technology "Apache Kafka"
      style {
        shape queue
      }
    }

    kafka_ui = container "Kafka UI" {
      description "Веб-интерфейс для мониторинга Kafka"
      technology "Kafka UI"
    }

    user_db = container "PostgreSQL (Users)" {
      description "База данных пользователей"
      technology "PostgreSQL Database"
      style {
        shape cylinder
      }
    }

    post_db = container "PostgreSQL (Posts)" {
      description "База данных постов, комментариев и лайков"
      technology "PostgreSQL Database"
      style {
        shape cylinder
      }
    }

    analytics_db = container "ClickHouse" {
      description "Аналитическая база данных для статистики и событий"
      technology "ClickHouse Database"
      style {
        shape cylinder
      }
    }
  }

  user -> social_network.api_gateway "Использует" {
    technology "HTTPS"
  }
  
  social_network.api_gateway -> social_network.user_service "Маршрутизирует запросы пользователей" {
    technology "gRPC"
  }
  
  social_network.api_gateway -> social_network.post_service "Маршрутизирует запросы постов" {
    technology "gRPC"
  }
  
  social_network.api_gateway -> social_network.statistics_service "Маршрутизирует запросы статистики" {
    technology "gRPC"
  }
  
  social_network.user_service -> social_network.user_db "Читает/Пишет данные пользователей" {
    technology "SQL"
  }
  
  social_network.post_service -> social_network.post_db "Читает/Пишет посты, комментарии, лайки" {
    technology "SQL"
  }
  
  social_network.statistics_service -> social_network.analytics_db "Читает/Пишет аналитические данные" {
    technology "SQL"
  }
  
  social_network.user_service -> social_network.message_broker "Публикует события регистрации" {
    technology "Kafka Producer"
  }
  
  social_network.post_service -> social_network.message_broker "Публикует события (просмотры, лайки, комментарии)" {
    technology "Kafka Producer"
  }
  
  social_network.statistics_service -> social_network.message_broker "Потребляет события для аналитики" {
    technology "Kafka Consumer"
  }
  
  social_network.kafka_ui -> social_network.message_broker "Мониторинг и управление" {
    technology "Kafka API"
  }
}

views {
  view index {
    include *
  }
  
  view socialNetwork {
    include *
  }
}